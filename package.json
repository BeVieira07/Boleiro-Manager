{
  "name": "brasfoot-web",
  "version": "0.1.0",
  "description": "Jogo de gerenciamento de futebol estilo Brasfoot com dados do Brasileirão",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx --yes serve .",
    "dados": "node --env-file=.env scripts/baixar-brasileirao.mjs",
    "dados:b": "node --env-file=.env scripts/baixar-brasileirao.mjs --serie=b --temporada=2024",
    "dados:padrao": "node scripts/gerar-dados-padrao.mjs",
    "escudos": "node scripts/baixar-escudos.mjs",
    "dados:c": "node --env-file=.env scripts/baixar-brasileirao.mjs --serie=c --temporada=2024",
    "dados:d": "node --env-file=.env scripts/baixar-brasileirao.mjs --serie=d --temporada=2024",
    "posicoes": "node scripts/baixar-posicoes.mjs",
    "notas": "node --env-file=.env scripts/baixar-notas.mjs"
  }
}
